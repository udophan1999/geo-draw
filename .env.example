# Lấy API key tại https://platform.deepseek.com/api_keys (máy chủ dùng chung key này)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_VISION_MODEL=deepseek-v4-flash-vision-exp
DEEPSEEK_BASE_URL=https://api.deepseek.com

# PostgreSQL cho tài khoản, cuộc trò chuyện và lượt dùng. Để trống thì dùng tệp SQLite
# trong thư mục dữ liệu (tiện khi chạy thử trên máy). Nên tạo một database riêng, ví dụ:
#   CREATE USER mathmate WITH PASSWORD '…';  CREATE DATABASE mathmate OWNER mathmate;
# Trong Docker, PostgreSQL chạy thẳng trên máy chủ thì dùng host.docker.internal làm tên máy.
DATABASE_URL=

# Tài khoản quản trị đầu tiên: được tạo khi máy chủ khởi động nếu chưa có quản trị viên nào
# (nếu tên đã có tài khoản thì chỉ cấp quyền, giữ mật khẩu cũ). Khi đã có quản trị viên thì
# hai dòng này không còn tác dụng; quản lý tiếp ở trang /admin.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Số lượt dùng AI mỗi ngày: mỗi lượt trợ giảng trả lời và mỗi lần vẽ bằng AI tính 1 lượt.
# Vẽ bằng Parser không tính.
GEO_DRAW_DAILY_LIMIT_USER=100
GEO_DRAW_DAILY_LIMIT_GUEST=10
# Khách chỉ được nhận diện bằng cookie (xóa cookie là có lượt mới), nên khách còn bị giới hạn
# chung theo địa chỉ IP. Cả trường học dùng chung một IP, nên để số này đủ lớn.
GEO_DRAW_DAILY_LIMIT_GUEST_IP=60
# Số tài khoản được tạo mỗi ngày từ một IP (chặn tạo hàng loạt tài khoản để lấy lượt).
GEO_DRAW_REGISTER_LIMIT_IP=20
# Tổng lượt AI của cả máy chủ mỗi ngày: chốt chặn cuối cho chi phí API. 0 = không giới hạn.
GEO_DRAW_DAILY_LIMIT_TOTAL=2000
# Đặt 1 khi chạy sau HTTPS để cookie đăng nhập chỉ gửi qua HTTPS.
GEO_DRAW_COOKIE_SECURE=0

# Docker ---------------------------------------------------------------------------------
# Chạy bằng docker-compose.yml (máy bất kỳ, mở cổng): cổng mở ra ngoài, mặc định 8000.
PORT=8000

# Production trên VPS (docker-compose.prod.yml, deploy.sh, Jenkinsfile). Trên VPS các giá trị
# này nằm trong managed config 'mathmate.tonyvibecode.com' của Jenkins (+ một .env cho deploy
# tay). GEO_DRAW_COOKIE_SECURE=1 và FORWARDED_ALLOW_IPS được đặt sẵn trong compose.
#
# Tên miền Traefik định tuyến tới (không có https://). Bản ghi DNS A phải có TRƯỚC lần deploy
# đầu, vì Let's Encrypt kiểm tra qua HTTP.
# APP_DOMAIN=mathmate.tonyvibecode.com
#
# DATABASE_URL trên VPS dùng TÊN CONTAINER Postgres làm tên máy (không phải localhost, cũng
# không phải host.docker.internal), và DB_NETWORK là mạng Docker của container đó:
#   docker ps --filter name=postgres --format '{{.Names}}'
#   docker inspect -f '{{range $k,$v := .NetworkSettings.Networks}}{{$k}} {{end}}' <pg-container>
# DATABASE_URL=postgresql://mathmate:MAT_KHAU@<pg-container>:5432/mathmate
# DB_NETWORK=<mạng của pg-container>
#
# Dải địa chỉ của Traefik mà ứng dụng tin header X-Forwarded-For (để biết IP thật của người
# dùng, cho giới hạn theo IP). Mặc định là các dải mạng Docker nội bộ; không bao giờ dùng "*".
# TRAEFIK_PROXY_IPS=172.16.0.0/12,10.0.0.0/8,192.168.0.0/16

# Sao lưu (scripts/backup.sh) ------------------------------------------------------------
# Cron KHÔNG được đọc .env của deploy (Jenkins xóa nó sau mỗi lần build). Đặt các dòng sau
# vào một tệp cố định, chmod 600, ví dụ /opt/mathmate/backup.env:
#   DATABASE_URL=…            (như trên)
#   BACKUP_DOCKER_NETWORK=…   (= DB_NETWORK)
#   BACKUP_RETENTION=48       (số bản giữ trên máy, mỗi loại)
#   RCLONE_REMOTE=gdrive:mathmate-backups   (chép ra ngoài VPS, cấu hình bằng `rclone config`)
#   RCLONE_RETENTION_DAYS=30
