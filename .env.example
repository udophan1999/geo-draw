# Lấy API key tại https://platform.deepseek.com/api_keys (máy chủ dùng chung key này)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_VISION_MODEL=deepseek-v4-flash-vision-exp
DEEPSEEK_BASE_URL=https://api.deepseek.com

# PostgreSQL cho tài khoản, cuộc trò chuyện và lượt dùng. Để trống thì dùng tệp SQLite
# trong thư mục dữ liệu (tiện khi chạy thử trên máy). Nên tạo một database riêng, ví dụ:
#   CREATE USER mathmate WITH PASSWORD '…';  CREATE DATABASE mathmate OWNER mathmate;
# Trong Docker, PostgreSQL chạy thẳng trên máy chủ thì dùng host.docker.internal làm tên máy.
DATABASE_URL=

# Tài khoản quản trị đầu tiên: được tạo khi máy chủ khởi động nếu chưa có quản trị viên nào
# (nếu tên đã có tài khoản thì chỉ cấp quyền, giữ mật khẩu cũ). Khi đã có quản trị viên thì
# hai dòng này không còn tác dụng; quản lý tiếp ở trang /admin.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Số lượt dùng AI mỗi ngày: mỗi lượt trợ giảng trả lời và mỗi lần vẽ bằng AI tính 1 lượt.
# Vẽ bằng Parser không tính.
GEO_DRAW_DAILY_LIMIT_USER=100
GEO_DRAW_DAILY_LIMIT_GUEST=10
# Đặt 1 khi chạy sau HTTPS để cookie đăng nhập chỉ gửi qua HTTPS.
GEO_DRAW_COOKIE_SECURE=0

# Docker (docker-compose.yml) -------------------------------------------------------------
# Cổng mở ra ngoài khi chạy không có Traefik (mặc định 8000).
PORT=8000
# Chạy sau Traefik (docker-compose.traefik.yml): tên miền đã trỏ DNS về máy chủ, và đặt
# GEO_DRAW_COOKIE_SECURE=1 ở trên. Ba tên sau phải khớp cấu hình Traefik trên máy chủ.
DOMAIN=
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt
