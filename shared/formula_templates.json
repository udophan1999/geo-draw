  {
    "id": "formulas",
    "name": "Công thức mẫu",
    "wide": true,
    "items": [
      {
        "label": "Định lý Pythagore",
        "latex": "BC^2=AB^2+AC^2"
      },
      {
        "label": "Hệ thức lượng: đường cao",
        "latex": "AH^2=BH\\cdot CH"
      },
      {
        "label": "Hệ thức lượng: cạnh góc vuông",
        "latex": "AB^2=BH\\cdot BC"
      },
      {
        "label": "Bình phương một tổng",
        "latex": "(a+b)^2=a^2+2ab+b^2"
      },
      {
        "label": "Bình phương một hiệu",
        "latex": "(a-b)^2=a^2-2ab+b^2"
      },
      {
        "label": "Hiệu hai bình phương",
        "latex": "a^2-b^2=(a-b)(a+b)"
      },
      {
        "label": "Biệt thức",
        "latex": "\\Delta=b^2-4ac"
      },
      {
        "label": "Công thức nghiệm",
        "latex": "x_{1,2}=\\frac{-b\\pm\\sqrt{\\Delta}}{2a}"
      },
      {
        "label": "Hệ thức Vi-ét",
        "latex": "x_1+x_2=-\\frac{b}{a},\\ x_1x_2=\\frac{c}{a}"
      },
      {
        "label": "Diện tích tam giác",
        "latex": "S=\\frac{1}{2}ah"
      },
      {
        "label": "Đường tròn",
        "latex": "C=2\\pi R,\\ S=\\pi R^2"
      },
      {
        "label": "Lượng giác cơ bản",
        "latex": "\\sin^2x+\\cos^2x=1"
      }
    ]
  }
